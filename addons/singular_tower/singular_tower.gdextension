[configuration]

entry_symbol = "singular_tower_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://addons/singular_tower/bin/libsingular_tower.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/singular_tower/bin/libsingular_tower.windows.template_release.x86_64.dll"
